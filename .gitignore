*.iml
*.lock
# pubspec.lock belongs in version control for an application: without it every
# CI build resolves dependencies afresh, so a transitive release can change the
# artifact without a single line of code changing. Commit it after the next
# `flutter pub get`.
!pubspec.lock
*.log
*.pyc
*.swp
.DS_Store
.dart_tool/
.packages
.pub/
.dart/
build/
.idea/
.vscode/
.settings/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web/
ios/
macos/
linux/
windows/
test/*.png
test/*.jpg
test/*.jpeg
coverage/
android/key.properties
android/local.properties
# CI writes the keystore to the repository root, so match it anywhere.
*.keystore
release.keystore
secrets/
*.env
*.env.*
!*.env.example
