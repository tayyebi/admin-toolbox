<?xml version="1.0" encoding="utf-8"?>
<!--
  The vault, the host inventory and the audit log must never leave the device
  through cloud backup or a device-to-device transfer. `allowBackup="false"`
  covers older releases; these rules cover Android 12+, where the two transfer
  paths are configured separately.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
